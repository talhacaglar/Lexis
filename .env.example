# Lexis — örnek ortam değişkenleri
# Bu dosyayı `.env` olarak kopyalayın ve değerleri doldurun.
#
# Not: Uygulama içinden Ayarlar ekranından girdiğiniz API anahtarı ve tema
# tercihi artık veritabanında (~/.lexis/lexis.db) saklanır. Bu .env dosyası
# yalnızca ilk kurulum / CI / geliştirme için isteğe bağlı bir alternatiftir.

# Google Gemini API anahtarı (https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=

# Tema: dark | light
APP_THEME=dark

# Log seviyesi: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# İsteğe bağlı: özel veritabanı yolu (boş ise ~/.lexis/lexis.db kullanılır)
# DATABASE_PATH=
